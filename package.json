{
  "name": "buscaconquista",
  "productName": "BuscaConquista",
  "version": "0.8.0",
  "description": "Mostra as conquistas que faltam nos seus jogos da Steam e ajuda a conquistá-las.",
  "main": "boot.js",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "package:win": "electron-packager . BuscaConquista --platform=win32 --arch=x64 --out=dist --icon=assets/icon.ico --overwrite --prune=true --asar --ignore=\"^/(dist|dist-instalador|test|dev|tools|screenshots|node_modules|README\\.md)(/|$)\"",
    "installer:win": "electron-builder --win nsis --x64",
    "update:gerar": "node tools/gerar-update.js"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.0.0",
    "@electron/asar": "^4.3.1"
  },
  "author": "Rodrigo",
  "build": {
    "appId": "br.com.rodrigo.buscaconquista",
    "productName": "BuscaConquista",
    "directories": {
      "output": "dist-instalador"
    },
    "files": [
      "boot.js",
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BuscaConquista"
    },
    "electronLanguages": [
      "pt-BR",
      "en-US"
    ],
    "compression": "maximum",
    "asar": true
  },
  "updateRepo": "rodrigopaduab/BuscaConquista"
}
